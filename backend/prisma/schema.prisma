generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Expedition {
  id              String           @id @default(cuid())
  name            String
  code            String           @unique
  destination     String?
  description     String?
  status          ExpeditionStatus @default(PLANNED)
  startDate       DateTime?
  endDate         DateTime?
  leadScientistId String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  personnel       Personnel[]
  leadScientist   Personnel?      @relation("ExpeditionLead", fields: [leadScientistId], references: [id], onDelete: SetNull)
  cargoItems      CargoItem[]
  inventoryItems  InventoryItem[]
  emergencyAlerts EmergencyAlert[]
  locations       Location[]
}

model Personnel {
  id           String           @id @default(cuid())
  expeditionId String
  firstName    String
  lastName     String
  email        String?
  phone        String?
  organization String?
  role         PersonnelRole    @default(MEMBER)
  status       PersonnelStatus  @default(ASSIGNED)
  lastKnownLocation String?
  currentLocationId String? @unique
  emergencyContact String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  expedition Expedition @relation(fields: [expeditionId], references: [id], onDelete: Cascade)
  ledExpeditions Expedition[] @relation("ExpeditionLead")
  currentLocation Location? @relation("PersonnelCurrentLocation", fields: [currentLocationId], references: [id], onDelete: SetNull)
  locationHistory PersonnelLocationHistory[]

  @@index([expeditionId])
  @@index([status])
}

model CargoItem {
  id           String        @id @default(cuid())
  expeditionId String
  trackingCode String        @unique
  name         String
  description  String?
  category     String?
  quantity     Int           @default(1)
  weightKg     Decimal?      @db.Decimal(10, 2)
  priority     CargoPriority @default(STANDARD)
  status       CargoStatus   @default(PLANNED)
  origin       String?
  destination  String?
  location     String?
  currentLocationId String? @unique
  expectedAt   DateTime?
  receivedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  expedition     Expedition      @relation(fields: [expeditionId], references: [id], onDelete: Cascade)
  inventoryItems InventoryItem[]
  currentLocation Location? @relation("CargoCurrentLocation", fields: [currentLocationId], references: [id], onDelete: SetNull)
  locationHistory CargoLocationHistory[]

  @@index([expeditionId])
  @@index([status])
}

model InventoryItem {
  id           String            @id @default(cuid())
  expeditionId String?
  cargoItemId  String?
  sku          String            @unique
  name         String
  description  String?
  quantity     Int               @default(0)
  reorderThreshold Int           @default(0)
  unit         String            @default("unit")
  location     String?
  condition    InventoryCondition @default(GOOD)
  lastCountedAt DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  expedition Expedition? @relation(fields: [expeditionId], references: [id], onDelete: SetNull)
  cargoItem  CargoItem?  @relation(fields: [cargoItemId], references: [id], onDelete: SetNull)

  @@index([expeditionId])
  @@index([cargoItemId])
}

model EmergencyAlert {
  id             String        @id @default(cuid())
  expeditionId   String
  createdById    String
  acknowledgedById String?
  title          String
  message        String
  severity       AlertSeverity @default(MEDIUM)
  status         AlertStatus   @default(OPEN)
  location       String?
  currentLocationId String? @unique
  resolvedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  expedition     Expedition @relation(fields: [expeditionId], references: [id], onDelete: Cascade)
  createdBy      User       @relation("CreatedAlerts", fields: [createdById], references: [id], onDelete: Restrict)
  acknowledgedBy User?      @relation("AcknowledgedAlerts", fields: [acknowledgedById], references: [id], onDelete: SetNull)
  currentLocation Location? @relation("EmergencyCurrentLocation", fields: [currentLocationId], references: [id], onDelete: SetNull)
  locationHistory EmergencyLocationHistory[]

  @@index([expeditionId, status])
  @@index([severity])
}

model Location {
  id               String         @id @default(cuid())
  latitude         Decimal        @db.Decimal(11, 8)
  longitude        Decimal        @db.Decimal(11, 8)
  observedAt       DateTime
  accuracyMeters   Decimal?       @db.Decimal(10, 2)
  altitudeMeters   Decimal?       @db.Decimal(10, 2)
  source           LocationSource @default(MANUAL)
  eventId          String?        @unique
  expeditionId     String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  expedition       Expedition?    @relation(fields: [expeditionId], references: [id], onDelete: SetNull)
  currentForPersonnel Personnel?  @relation("PersonnelCurrentLocation")
  currentForCargo   CargoItem?    @relation("CargoCurrentLocation")
  currentForEmergency EmergencyAlert? @relation("EmergencyCurrentLocation")
  personnelHistory PersonnelLocationHistory[]
  cargoHistory     CargoLocationHistory[]
  emergencyHistory EmergencyLocationHistory[]

  @@index([expeditionId, observedAt])
  @@index([observedAt])
}

model PersonnelLocationHistory {
  id           String   @id @default(cuid())
  personnelId  String
  locationId   String
  createdAt    DateTime @default(now())

  personnel Personnel @relation(fields: [personnelId], references: [id], onDelete: Cascade)
  location  Location  @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([personnelId, locationId])
  @@index([personnelId, createdAt])
}

model CargoLocationHistory {
  id          String   @id @default(cuid())
  cargoItemId String
  locationId  String
  createdAt   DateTime @default(now())

  cargoItem CargoItem @relation(fields: [cargoItemId], references: [id], onDelete: Cascade)
  location  Location  @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([cargoItemId, locationId])
  @@index([cargoItemId, createdAt])
}

model EmergencyLocationHistory {
  id              String   @id @default(cuid())
  emergencyAlertId String
  locationId      String
  createdAt       DateTime @default(now())

  emergencyAlert EmergencyAlert @relation(fields: [emergencyAlertId], references: [id], onDelete: Cascade)
  location       Location      @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([emergencyAlertId, locationId])
  @@index([emergencyAlertId, createdAt])
}

model User {
  id                   String          @id @default(cuid())
  email                String          @unique
  name                 String
  passwordHash         String
  role                 UserRole        @default(FIELD_PERSONNEL)
  isActive             Boolean         @default(true)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  createdAlerts        EmergencyAlert[] @relation("CreatedAlerts")
  acknowledgedAlerts   EmergencyAlert[] @relation("AcknowledgedAlerts")
}

enum ExpeditionStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum PersonnelRole {
  LEAD
  SCIENTIST
  LOGISTICS
  MEDICAL
  ENGINEER
  MEMBER
}

enum PersonnelStatus {
  ASSIGNED
  ON_SITE
  RETURNED
  INACTIVE
}

enum CargoPriority {
  LOW
  STANDARD
  HIGH
  CRITICAL
}

enum CargoStatus {
  PLANNED
  IN_TRANSIT
  AT_DESTINATION
  RECEIVED
  LOST
}

enum InventoryCondition {
  NEW
  GOOD
  NEEDS_REPAIR
  DAMAGED
  RETIRED
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

enum LocationSource {
  MANUAL
  GPS
  SYSTEM
  IMPORT
  SIMULATION
}

enum UserRole {
  ADMIN
  COORDINATOR
  FIELD_PERSONNEL
  LOGISTICS_OFFICER
}
