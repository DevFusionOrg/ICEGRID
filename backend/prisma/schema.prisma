generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Expedition {
  id              String           @id @default(cuid())
  name            String
  code            String           @unique
  destination     String?
  description     String?
  status          ExpeditionStatus @default(PLANNED)
  startDate       DateTime?
  endDate         DateTime?
  leadScientistId String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  personnel       Personnel[]
  leadScientist   Personnel?      @relation("ExpeditionLead", fields: [leadScientistId], references: [id], onDelete: SetNull)
  cargoItems      CargoItem[]
  inventoryItems  InventoryItem[]
  emergencyAlerts EmergencyAlert[]
}

model Personnel {
  id           String           @id @default(cuid())
  expeditionId String
  firstName    String
  lastName     String
  email        String?
  phone        String?
  organization String?
  role         PersonnelRole    @default(MEMBER)
  status       PersonnelStatus  @default(ASSIGNED)
  emergencyContact String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  expedition Expedition @relation(fields: [expeditionId], references: [id], onDelete: Cascade)
  ledExpeditions Expedition[] @relation("ExpeditionLead")

  @@index([expeditionId])
  @@index([status])
}

model CargoItem {
  id           String        @id @default(cuid())
  expeditionId String
  trackingCode String        @unique
  name         String
  description  String?
  category     String?
  quantity     Int           @default(1)
  weightKg     Decimal?      @db.Decimal(10, 2)
  priority     CargoPriority @default(STANDARD)
  status       CargoStatus   @default(PLANNED)
  origin       String?
  destination  String?
  location     String?
  expectedAt   DateTime?
  receivedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  expedition     Expedition      @relation(fields: [expeditionId], references: [id], onDelete: Cascade)
  inventoryItems InventoryItem[]

  @@index([expeditionId])
  @@index([status])
}

model InventoryItem {
  id           String            @id @default(cuid())
  expeditionId String?
  cargoItemId  String?
  sku          String            @unique
  name         String
  description  String?
  quantity     Int               @default(0)
  unit         String            @default("unit")
  location     String?
  condition    InventoryCondition @default(GOOD)
  lastCountedAt DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  expedition Expedition? @relation(fields: [expeditionId], references: [id], onDelete: SetNull)
  cargoItem  CargoItem?  @relation(fields: [cargoItemId], references: [id], onDelete: SetNull)

  @@index([expeditionId])
  @@index([cargoItemId])
}

model EmergencyAlert {
  id             String        @id @default(cuid())
  expeditionId   String
  createdById    String
  acknowledgedById String?
  title          String
  message        String
  severity       AlertSeverity @default(MEDIUM)
  status         AlertStatus   @default(OPEN)
  location       String?
  resolvedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  expedition     Expedition @relation(fields: [expeditionId], references: [id], onDelete: Cascade)
  createdBy      User       @relation("CreatedAlerts", fields: [createdById], references: [id], onDelete: Restrict)
  acknowledgedBy User?      @relation("AcknowledgedAlerts", fields: [acknowledgedById], references: [id], onDelete: SetNull)

  @@index([expeditionId, status])
  @@index([severity])
}

model User {
  id                   String          @id @default(cuid())
  email                String          @unique
  name                 String
  passwordHash         String
  role                 UserRole        @default(FIELD_PERSONNEL)
  isActive             Boolean         @default(true)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  createdAlerts        EmergencyAlert[] @relation("CreatedAlerts")
  acknowledgedAlerts   EmergencyAlert[] @relation("AcknowledgedAlerts")
}

enum ExpeditionStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum PersonnelRole {
  LEAD
  SCIENTIST
  LOGISTICS
  MEDICAL
  ENGINEER
  MEMBER
}

enum PersonnelStatus {
  ASSIGNED
  ON_SITE
  RETURNED
  INACTIVE
}

enum CargoPriority {
  LOW
  STANDARD
  HIGH
  CRITICAL
}

enum CargoStatus {
  PLANNED
  IN_TRANSIT
  AT_DESTINATION
  RECEIVED
  LOST
}

enum InventoryCondition {
  NEW
  GOOD
  NEEDS_REPAIR
  DAMAGED
  RETIRED
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

enum UserRole {
  ADMIN
  COORDINATOR
  FIELD_PERSONNEL
  LOGISTICS_OFFICER
}
